# PostgreSQL Database Connection URL
# Replace with your PostgreSQL connection string (Local, Supabase, Neon, AWS RDS, etc.)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/juricious"

# Default Admin Credentials
ADMIN_DEFAULT_EMAIL="admin@juricious.com"
ADMIN_DEFAULT_PASSWORD="Admin@1234"

# Application Environment
NODE_ENV="development"
PORT=3000
